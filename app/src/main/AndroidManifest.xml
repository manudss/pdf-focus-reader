<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="${appLabel}" android:icon="${appIcon}" android:theme="@style/AppTheme" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><data android:scheme="content" android:mimeType="application/pdf"/><data android:scheme="file"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="application/pdf"/></intent-filter>
        </activity>
        <provider android:name=".ArticleImageProvider" android:authorities="${applicationId}.article-images" android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".TutorialActivity" android:exported="false"/>
    </application>
</manifest>
